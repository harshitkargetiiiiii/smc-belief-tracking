# Private per-recipient delivery build of threshold_SMC (staged gate 2).
#
# Same computation as the debug build threshold_smc.mpc, but each recipient's
# (accept_j, payload_j) is delivered PRIVATELY to party j via reveal_to(j) +
# print_ln_to(j, ...). No party learns another party's verdict, and NO verdict
# or weight is broadcast. Belief weights are NOT output here (they are the
# persistent Sigma_T state -- that is the NEXT phase and is out of scope).
#
# Run with -OF . so every party prints its own private output; capture each
# party's stdout separately (see conformance/private_run.py). The debug build
# and the whole functional conformance suite are UNCHANGED.
#
# This build demonstrates private delivery FUNCTIONALLY (the cleartext verdict
# reaches only the intended party's process). It is NOT a simulation-security
# proof -- see conformance/ADVERSARY.md.

Q = program.args[1] if len(program.args) > 1 else 'p1_is_max'
D = [0, 1, 2]
N = 3
S = 27
A, B = 1, 2


def state(idx):
    return (idx // 9, (idx // 3) % 3, idx % 3)


def qval(s):
    x0, x1, x2 = s
    if Q == 'p1_is_max':
        return int(x0 >= x1 and x0 >= x2)
    if Q == 'sum_even':
        return int((x0 + x1 + x2) % 2 == 0)
    raise Exception('unknown query: ' + Q)


QV = [qval(state(i)) for i in range(S)]
OQ = sorted(set(QV))

sj = [None] * N
delta = [[None] * S for _ in range(N)]
for j in range(N):
    sj[j] = sint.get_input_from(j)
    for idx in range(S):
        delta[j][idx] = sint.get_input_from(j)

o_actual = sint(0)
for idx in range(S):
    x0, x1, x2 = state(idx)
    onehot = (sj[0] == x0) * (sj[1] == x1) * (sj[2] == x2)
    o_actual = o_actual + QV[idx] * onehot

accept = [None] * N
payload = [None] * N
for j in range(N):
    viol = sint(0)
    for i in range(N):
        if i == j:
            continue
        for o in OQ:
            Z = sum((delta[j][idx] for idx in range(S) if QV[idx] == o), sint(0))
            for n in D:
                M = sum((delta[j][idx] for idx in range(S)
                         if QV[idx] == o and state(idx)[i] == n), sint(0))
                viol = viol + (A * Z < B * M)
    accept[j] = (viol == 0)
    payload[j] = accept[j].if_else(o_actual, 0)

# ---- PRIVATE delivery: only party j learns (accept_j, payload_j) ----
for j in range(N):
    print_ln_to(j, 'PRIV %s ACCEPT %s', j, accept[j].reveal_to(j))
    print_ln_to(j, 'PRIV %s PAYLOAD %s', j, payload[j].reveal_to(j))

# [H-R1] held-out: extra foreign recipient -- party 0's payload also to player 1
print_ln_to(1, 'PRIV 0 PAYLOAD %s', payload[0].reveal_to(1))
