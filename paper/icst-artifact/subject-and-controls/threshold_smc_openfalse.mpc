# INTENTIONALLY LEAKY sibling #4 (negative control): the MAIN tape is the private
# build, but a SEPARATE tape named `EQZ(3)_63` (a name the real comparison library
# also emits) publicly reconstructs party 1's verdict with `reveal(False)`.
#
# Reproduces re-review-4: `asm_open(..., False, ...)` is STILL a public reveal in
# MP-SPDZ -- the `False` flag only skips the post-open check, it does NOT keep the
# value private. The re-review-3 gate only forbade `True` opens and allowed
# `False` opens inside `(EQZ|LTZ)\(`-named subtapes, so this leaked (all parties
# reconstruct accept[1]) with no stdout, no privateoutput, no sink.
#
# The re-review-4 gate REJECTS it: an author cannot ADD an open without changing
# the non-main tape multiset, which is pinned to exactly the comparison subtapes
# the computation is supposed to generate.

Q = program.args[1] if len(program.args) > 1 else 'p1_is_max'
D = [0, 1, 2]
N = 3
S = 27
A, B = 1, 2


def state(idx):
    return (idx // 9, (idx // 3) % 3, idx % 3)


def qval(s):
    x0, x1, x2 = s
    if Q == 'p1_is_max':
        return int(x0 >= x1 and x0 >= x2)
    if Q == 'sum_even':
        return int((x0 + x1 + x2) % 2 == 0)
    raise Exception('unknown query: ' + Q)


QV = [qval(state(i)) for i in range(S)]
OQ = sorted(set(QV))

sj = [None] * N
delta = [[None] * S for _ in range(N)]
for j in range(N):
    sj[j] = sint.get_input_from(j)
    for idx in range(S):
        delta[j][idx] = sint.get_input_from(j)

o_actual = sint(0)
for idx in range(S):
    x0, x1, x2 = state(idx)
    onehot = (sj[0] == x0) * (sj[1] == x1) * (sj[2] == x2)
    o_actual = o_actual + QV[idx] * onehot

accept = [None] * N
payload = [None] * N
for j in range(N):
    viol = sint(0)
    for i in range(N):
        if i == j:
            continue
        for o in OQ:
            Z = sum((delta[j][idx] for idx in range(S) if QV[idx] == o), sint(0))
            for n in D:
                M = sum((delta[j][idx] for idx in range(S)
                         if QV[idx] == o and state(idx)[i] == n), sint(0))
                viol = viol + (A * Z < B * M)
    accept[j] = (viol == 0)
    payload[j] = accept[j].if_else(o_actual, 0)


# ---- the hidden leak: a False public reveal of party 1's verdict ----
accept[1].store_in_mem(4000)


def _reveal_false():
    sint.load_mem(4000).reveal(False)     # asm_open ..., False == public reveal


program.run_tapes([program.new_tape(_reveal_false, name='EQZ(3)_63')])

# ---- MAIN tape: identical private delivery to threshold_smc_private.mpc ----
for j in range(N):
    print_ln_to(j, 'PRIV %s ACCEPT %s', j, accept[j].reveal_to(j))
    print_ln_to(j, 'PRIV %s PAYLOAD %s', j, payload[j].reveal_to(j))
