# INTENTIONALLY LEAKY sibling #2 (negative control): the MAIN tape is byte-for-
# byte the private build (privateoutput to [0,0,1,1,2,2], no public open), so the
# OLD main-tape-only inspector ACCEPTED it. The leak hides in a SEPARATE
# @function_tape that does a PUBLIC reveal() + an UNCONDITIONAL print_ln('LEAK').
#
# This reproduces Codex's gate-2 re-review-2 blocker 1 ("separate-tape public
# reveal/LEAK output"). The complete-tape-manifest inspector
# (conformance/delivery_inspect.py) REJECTS it because the extra tape is a
# non-masked tape carrying a public open and an unconditional cleartext print.
# The strict two-line stdout parser (conformance/private_run.py) ALSO rejects it
# at runtime, because the unconditional LEAK line appears on every party's stdout
# as a forbidden third line.
#
# Same computation, inputs, and query interface as threshold_smc_private.mpc.

Q = program.args[1] if len(program.args) > 1 else 'p1_is_max'
D = [0, 1, 2]
N = 3
S = 27
A, B = 1, 2


def state(idx):
    return (idx // 9, (idx // 3) % 3, idx % 3)


def qval(s):
    x0, x1, x2 = s
    if Q == 'p1_is_max':
        return int(x0 >= x1 and x0 >= x2)
    if Q == 'sum_even':
        return int((x0 + x1 + x2) % 2 == 0)
    raise Exception('unknown query: ' + Q)


QV = [qval(state(i)) for i in range(S)]
OQ = sorted(set(QV))

sj = [None] * N
delta = [[None] * S for _ in range(N)]
for j in range(N):
    sj[j] = sint.get_input_from(j)
    for idx in range(S):
        delta[j][idx] = sint.get_input_from(j)

o_actual = sint(0)
for idx in range(S):
    x0, x1, x2 = state(idx)
    onehot = (sj[0] == x0) * (sj[1] == x1) * (sj[2] == x2)
    o_actual = o_actual + QV[idx] * onehot

accept = [None] * N
payload = [None] * N
for j in range(N):
    viol = sint(0)
    for i in range(N):
        if i == j:
            continue
        for o in OQ:
            Z = sum((delta[j][idx] for idx in range(S) if QV[idx] == o), sint(0))
            for n in D:
                M = sum((delta[j][idx] for idx in range(S)
                         if QV[idx] == o and state(idx)[i] == n), sint(0))
                viol = viol + (A * Z < B * M)
    accept[j] = (viol == 0)
    payload[j] = accept[j].if_else(o_actual, 0)


# ---- the hidden leak: a SEPARATE tape that PUBLICLY opens and prints ----
@function_tape
def leak_final(x):
    print_ln('LEAK %s', x.reveal())


# ---- MAIN tape: identical private delivery to threshold_smc_private.mpc ----
for j in range(N):
    print_ln_to(j, 'PRIV %s ACCEPT %s', j, accept[j].reveal_to(j))
    print_ln_to(j, 'PRIV %s PAYLOAD %s', j, payload[j].reveal_to(j))
    leak_final(accept[j])
    leak_final(payload[j])
