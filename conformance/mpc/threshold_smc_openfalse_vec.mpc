# INTENTIONALLY LEAKY sibling #5 (negative control): the VECTORIZED-memory variant
# of threshold_smc_openfalse. It moves party 1's verdict into a spoofed `EQZ(3)_63`
# subtape and publicly reconstructs it, but crosses the tape boundary with
# VECTORIZED memory ops (`vstms` in MAIN, `vldms` in the subtape) instead of the
# scalar `stms`/`ldms`.
#
# Reproduces re-review-6: the re-review-5 memory-channel regex matched only the
# scalar `stm*`/`ldm*` opcodes, so the vectorized `vstms`/`vldms` forms slipped
# through. The fixed regex (`v?g?stm*` / `v?g?ldm*`) REJECTS this on rules (g)+(h).

Q = program.args[1] if len(program.args) > 1 else 'p1_is_max'
D = [0, 1, 2]
N = 3
S = 27
A, B = 1, 2


def state(idx):
    return (idx // 9, (idx // 3) % 3, idx % 3)


def qval(s):
    x0, x1, x2 = s
    if Q == 'p1_is_max':
        return int(x0 >= x1 and x0 >= x2)
    if Q == 'sum_even':
        return int((x0 + x1 + x2) % 2 == 0)
    raise Exception('unknown query: ' + Q)


QV = [qval(state(i)) for i in range(S)]
OQ = sorted(set(QV))

sj = [None] * N
delta = [[None] * S for _ in range(N)]
for j in range(N):
    sj[j] = sint.get_input_from(j)
    for idx in range(S):
        delta[j][idx] = sint.get_input_from(j)

o_actual = sint(0)
for idx in range(S):
    x0, x1, x2 = state(idx)
    onehot = (sj[0] == x0) * (sj[1] == x1) * (sj[2] == x2)
    o_actual = o_actual + QV[idx] * onehot

accept = [None] * N
payload = [None] * N
for j in range(N):
    viol = sint(0)
    for i in range(N):
        if i == j:
            continue
        for o in OQ:
            Z = sum((delta[j][idx] for idx in range(S) if QV[idx] == o), sint(0))
            for n in D:
                M = sum((delta[j][idx] for idx in range(S)
                         if QV[idx] == o and state(idx)[i] == n), sint(0))
                viol = viol + (A * Z < B * M)
    accept[j] = (viol == 0)
    payload[j] = accept[j].if_else(o_actual, 0)


# ---- the hidden leak: VECTORIZED store/load of party 1's verdict ----
leakvec = sint(0, size=2)
leakvec += accept[1]                    # [accept1, accept1]
leakvec.store_in_mem(4000)              # vstms in MAIN


def _reveal_false_vec():
    w = sint.load_mem(4000, size=2)     # vldms in the subtape
    w.reveal(False)                     # public reconstruction


program.run_tapes([program.new_tape(_reveal_false_vec, name='EQZ(3)_63')])

# ---- MAIN tape: identical private delivery to threshold_smc_private.mpc ----
for j in range(N):
    print_ln_to(j, 'PRIV %s ACCEPT %s', j, accept[j].reveal_to(j))
    print_ln_to(j, 'PRIV %s PAYLOAD %s', j, payload[j].reveal_to(j))
